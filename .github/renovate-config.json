{
    "username": "renovate85-bot[bot]",
    "repositories": [
        "pando85/homelab"
    ],
    "allowedCommands": [
        "^bash apps/firecrawl/hack/update-nuq-sql\\.sh [0-9]+\\.[0-9]+\\.[0-9]+$"
    ],
    "packageRules": [
        {
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "ghcr.io/firecrawl/firecrawl"
            ],
            "postUpgradeTasks": {
                "commands": [
                    "bash apps/firecrawl/hack/update-nuq-sql.sh {{{newVersion}}}"
                ],
                "fileFilters": [
                    "apps/firecrawl/files/nuq.sql"
                ],
                "executionMode": "update"
            }
        }
    ]
}
