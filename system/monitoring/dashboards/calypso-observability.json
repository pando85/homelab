{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Calypso four-signals observability: metrics (RED from spanmetrics + app), traces, logs, and profiles. Cross-linked via datasource correlation config.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Pyroscope Profile Exploration",
      "type": "link",
      "url": "/d/pyroscope-profile-exploration",
      "icon": "external link",
      "tooltip": "Open the dedicated Pyroscope profile exploration dashboard"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Metrics — RED (Spanmetrics)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Request rate (calls/sec) from Tempo spanmetrics. Exemplar dots (if present) link to the trace. Exemplars are emitted by the metrics-generator for histogram bucket series (traces_spanmetrics_latency_bucket), NOT for counter series (traces_spanmetrics_calls_total).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "exemplar": { "color": "#FF9830", "lineOpacity": 0.3 },
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Error rate (calls with STATUS_CODE_ERROR / total) from spanmetrics.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "percentunit",
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": {
        "exemplar": { "color": "#FF9830", "lineOpacity": 0.3 },
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\",status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Latency histogram (p50, p90, p99) from spanmetrics. Exemplar dots link to traces when available — the metrics-generator emits exemplars for histogram bucket series (traces_spanmetrics_latency_bucket) but NOT for counter series.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": {
        "exemplar": { "color": "#FF9830", "lineOpacity": 0.3 },
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (service, le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p50 {{service}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.90, sum by (service, le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p90 {{service}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p99 {{service}}",
          "refId": "C"
        }
      ],
      "title": "Latency (p50 / p90 / p99)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Metrics — Calypso App (no exemplars: OTel Rust SDK has no exemplar reservoir)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "NOTE: App-level exemplars are NOT available — the OTel Rust SDK does not implement an exemplar reservoir. These panels have no clickable exemplar dots. For trace correlation, use the spanmetrics panels above or the Traces row below.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(calypso_control_plane_http_requests_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Control Plane HTTP Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Control plane HTTP latency histogram (p50, p90, p99). No exemplars available (Rust SDK limitation).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(calypso_control_plane_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.90, sum by (le) (rate(calypso_control_plane_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(calypso_control_plane_http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Control Plane HTTP Latency (p50 / p90 / p99)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Traces",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "TraceQL search by service. Uses resource.service.name (the OTel resource attribute). Click a trace to open the trace viewer.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 19 },
      "id": 6,
      "options": {
        "search": {
          "query": "{ resource.service.name =~ \"$service\" }",
          "serviceMapInclude": false
        },
        "showTraceIds": true
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "search",
          "query": "{ resource.service.name =~ \"$service\" }",
          "refId": "A"
        }
      ],
      "title": "Trace Search (TraceQL)",
      "type": "traces"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "id": 103,
      "title": "Logs",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Logs filtered by namespace and container. Loki label mapping (measured 2026-10-10): OTel service.name 'calypso-control-plane' → container='control-plane', OTel 'calypso-auth-proxy' → container='auth-proxy', OTel 'calypso-git-proxy' → container='git-proxy', OTel 'calypso-runner' → container='runner'. The Loki service_name label does NOT match OTel service.name (it uses short names like 'calypso', 'git-proxy').",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 30 },
      "id": 7,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{namespace=\"$namespace\", container=~\"$container\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Logs (namespace=$namespace, container=$container)",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Pivot panel: shows logs for a specific trace_id. Set the trace_id variable above to filter. Only control-plane emits trace_id in JSON logs; auth-proxy and git-proxy use text format without trace context.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 42 },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{namespace=\"$namespace\"} |= \"$trace_id\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Logs by Trace ID ($trace_id)",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 },
      "id": 104,
      "title": "Profiles",
      "type": "row"
    },
    {
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
      "description": "CPU flame graph for the selected service. The service_name label maps from span service.name via tracesToProfiles config. After Alloy alignment (cb41d99a), Pyroscope service_name values are calypso-control-plane, calypso-auth-proxy, calypso-git-proxy — matching OTel service.name exactly. NOTE: Pyroscope v2 query API returns empty results as of 2026-10-10 despite active ingest. This is a Pyroscope v2 data/query issue, not a dashboard config issue.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 53 },
      "id": 9,
      "options": {
        "flameGraph": {
          "maxNodes": 16384,
          "minWidth": 0
        }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
          "queryType": "profile",
          "profileTypeId": "process_cpu_cpu:nanoseconds:cpu:nanoseconds",
          "labelName": "service_name",
          "serviceName": "$serviceName"
        }
      ],
      "title": "CPU Profile — $serviceName",
      "type": "flamegraph"
    }
  ],
  "schemaVersion": 39,
