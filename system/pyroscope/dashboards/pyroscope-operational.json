   },
   "description": "pyroscope.write push_downstream latency. Aggregated with sum by (le, node) over a 10m window: the collector only pushes when a target has samples in the interval, so a narrow window yields NaN for an idle node (e.g. a proxy at zero CPU).",
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 40
   },
   "id": 25,
   "options": {
    "legend": {
     "calcs": [
      "lastNotNull"
     ],
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "histogram_quantile(0.5, sum by (le, node) (rate(pyroscope_write_latency_bucket{namespace=\"alloy\", type=\"push_downstream\"}[10m])))",
     "legendFormat": "p50 {{node}}",
     "range": true,
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "editorMode": "code",
     "expr": "histogram_quantile(0.95, sum by (le, node) (rate(pyroscope_write_latency_bucket{namespace=\"alloy\", type=\"push_downstream\"}[10m])))",
     "legendFormat": "p95 {{node}}",
     "range": true,
     "refId": "B"
    }
   ],
   "title": "Alloy: write latency to Pyroscope (p50 / p95)",
   "type": "timeseries"
