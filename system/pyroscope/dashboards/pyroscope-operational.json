{
  "annotations": { "list": [] },
  "description": "Operational dashboard for Pyroscope backend and OTel eBPF profiler DaemonSet. ALL metric names are CANDIDATES — verify against /metrics post-deploy.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Pyroscope pod CPU usage. VERIFY-AT-DEPLOY: metric name is a candidate.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "single" } },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{namespace=\"pyroscope\", container=\"pyroscope\"}[5m])",
          "legendFormat": "{{pod}}"
        }
      ],
      "title": "Pyroscope CPU",
      "type": "timeseries"
    },
    {
