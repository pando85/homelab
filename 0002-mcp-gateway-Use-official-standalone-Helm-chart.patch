-# Gateway plane ingress: least-privilege, derived from live labels verified with
-# `kubectl get pods -o jsonpath` in this cluster:
-#   ingress-nginx-external / app.kubernetes.io/name=ingress-nginx
-#   ingress-nginx          / app.kubernetes.io/name=ingress-nginx
-#   monitoring             / app.kubernetes.io/name=prometheus
-#
