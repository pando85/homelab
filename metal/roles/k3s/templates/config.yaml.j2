{% if inventory_hostname == groups['kube_control_plane'][0] %}
cluster-init: true
{% else %}
{# Use the inventory name, not hostvars[].ansible_hostname: under --limit the control plane's facts
   are never gathered, and delegate_to does not gather them either, so that reference dies with
   "object of type 'HostVarsVars' has no attribute 'ansible_hostname'". #}
server: https://{{ groups['kube_control_plane'][0] }}:6443
{% endif %}
token-file: {{ k3s_token_file }}
{% if 'kube_control_plane' in group_names %}
{{ k3s_server_config | to_nice_yaml }}
{% endif %}
kubelet-arg:
- "cluster-dns=10.43.0.10"
