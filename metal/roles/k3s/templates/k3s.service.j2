[Unit]
Description=Lightweight Kubernetes
Documentation=https://k3s.io
After=network-online.target

[Service]
Type=notify
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/k3s {{ 'server' if 'kube_control_plane' in group_names else 'agent' }} \
{% if 'kube_control_plane' in group_names %}
  --kube-controller-manager-arg "node-monitor-period=5s" \
  --kube-controller-manager-arg "node-monitor-grace-period=40s" \
  --kube-apiserver-arg "default-not-ready-toleration-seconds=300" \
  --kube-apiserver-arg "default-unreachable-toleration-seconds=300" \
  --flannel-backend=none \
  --disable-kube-proxy \
{% endif %}
{% for item in k3s_kubelet_extra_args %}
  --kubelet-arg "{{ item }}" \
{% endfor %}
  --kubelet-arg "node-status-update-frequency=4s" \
  --kubelet-arg "container-log-max-size=1Mi" \
  --kubelet-arg "container-log-max-files=2" \
  --kubelet-arg "max-pods=250"
KillMode=process
Delegate=yes
# Having non-zero Limit*s causes performance problems due to accounting overhead
# in the kernel. We recommend using cgroups to do container-local accounting.
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
{% if 'kube_control_plane' in group_names %}
# Best-effort reclaim protection for the k3s process (embeds etcd). Depends on the parent
# system.slice having a matching MemoryLow budget (see system.slice.d/memory-protection.conf).
# Without ancestor budget the kernel caps effective memory.low at the parent's value.
MemoryLow={{ k3s_control_plane_memory_low }}
{% endif %}
TimeoutStartSec=0
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
