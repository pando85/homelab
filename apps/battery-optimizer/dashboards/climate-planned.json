{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Heat-pump consumption forecast (interface specified, not built) and boost mode (planned, not built): the baselines and preconditions that can be measured today. Their own KPIs start when they are built. KPIs of docs/components/hp-consumption-forecast.md and boost-mode.md.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "climate"
      ],
      "targetBlank": false,
      "title": "Climate dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Heat-pump consumption forecast (planned): what it must predict, and the bar to beat",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "text",
      "title": "Status",
      "id": 2,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "options": {
        "mode": "markdown",
        "content": "The forecast does not exist yet (`sensor.hp_planned_energy` is specified, not built), so there is no forecast-error KPI. The panels show the heat-pump load it must predict and a naive baseline (the same 15-minute slot yesterday), the error a real forecast has to beat. Heat-pump basis: the HeishaMon-reported power (the branch meter reads about 1.28 times higher)."
      }
    },
    {
      "type": "timeseries",
      "title": "Heat-pump electricity per 15 min slot (kWh): Actual and Baseline (same slot yesterday)",
      "id": 3,
      "description": "Mean HeishaMon power of the slot (sensor.aquarea_power_consumed) / 4000. Baseline is the value 24 h earlier: the persistence forecast, not the planned forecast.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg_over_time(max(hass_sensor_power_w{entity=\"sensor.aquarea_power_consumed\"})[15m:1m]) / 4000",
          "legendFormat": "Actual",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg_over_time(max(hass_sensor_power_w{entity=\"sensor.aquarea_power_consumed\"})[15m:1m] offset 1d) / 4000",
          "legendFormat": "Baseline (same slot yesterday)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Actual"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Baseline (same slot yesterday)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Heat-pump power by kind (W)",
      "id": 4,
      "description": "HeishaMon electrical power by kind: space heating, hot water and cooling (the kinds of slots[] in the interface).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(hass_sensor_power_w{entity=\"sensor.aquarea_heat_power_consumed\"})",
          "legendFormat": "Heat",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(hass_sensor_power_w{entity=\"sensor.aquarea_dhw_power_consumed\"})",
          "legendFormat": "Hot water",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(hass_sensor_power_w{entity=\"sensor.aquarea_cool_power_consumed\"})",
          "legendFormat": "Cooling",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Baseline MAE per 15 min slot (kWh, rolling 24 h)",
      "id": 5,
      "description": "mean |Actual - same slot yesterday| over the last 24 h. A forecast earns its place by a lower MAE and a smaller bias than this.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg_over_time(abs(avg_over_time(max(hass_sensor_power_w{entity=\"sensor.aquarea_power_consumed\"})[15m:1m]) / 4000 - avg_over_time(max(hass_sensor_power_w{entity=\"sensor.aquarea_power_consumed\"})[15m:1m] offset 1d) / 4000)[1d:15m])",
          "legendFormat": "Baseline MAE",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Baseline bias per slot (kWh, actual minus baseline, rolling 24 h)",
      "id": 6,
      "description": "mean (Actual - same slot yesterday) over the last 24 h; the total of the day is the difference of the two daily energies.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg_over_time((avg_over_time(max(hass_sensor_power_w{entity=\"sensor.aquarea_power_consumed\"})[15m:1m]) / 4000 - avg_over_time(max(hass_sensor_power_w{entity=\"sensor.aquarea_power_consumed\"})[15m:1m] offset 1d) / 4000)[1d:15m])",
          "legendFormat": "Baseline bias",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Heat-pump share of the house load (rolling 24 h)",
      "id": 7,
      "description": "Mean heat-pump power (HeishaMon) / mean estimated house load (grid minus battery AC power, branch meter basis): how much of the load this forecast could remove from the battery forecast's error.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg_over_time(max(hass_sensor_power_w{entity=\"sensor.aquarea_power_consumed\"})[1d:5m]) / avg_over_time(max(battery_optimizer_actuator_house_load_watts)[1d:5m])",
          "legendFormat": "Share",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Consumer: house-load forecast MAE per slot (kWh, rolling 24 h)",
      "id": 8,
      "description": "The battery load forecast, whose error this forecast is meant to reduce (same panel as Battery: load forecast).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(battery_optimizer_load_forecast_abs_error_kwh_total{plan=\"day_ahead\"}[1d])) / sum(increase(battery_optimizer_load_forecast_scored_slots_total{plan=\"day_ahead\"}[1d]))",
          "legendFormat": "Day-ahead plan",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(battery_optimizer_load_forecast_abs_error_kwh_total{plan=\"final\"}[1d])) / sum(increase(battery_optimizer_load_forecast_scored_slots_total{plan=\"final\"}[1d]))",
          "legendFormat": "Final plan",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Day-ahead plan"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Final plan"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Boost mode (planned): the preconditions and safety limits it will have to respect",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": []
    },
    {
      "type": "text",
      "title": "Status",
      "id": 10,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "options": {
        "mode": "markdown",
        "content": "Boost has no rule, threshold or interlock yet, so there are no activation or soak KPIs. These panels measure the limits it must respect: the 5.0 kW import limit with the battery charging, the battery state the soak waits for, the 50 degC hot-water cap and the heaters staying off."
      }
    },
    {
      "type": "timeseries",
      "title": "Grid import against the 5.0 kW limit (W)",
      "id": 11,
      "description": "Measured grid power (+ import) and its 15 min mean; the smart meter cuts supply above 5.0 kW (limit line). Boost plus the battery charge plus the house load must stay below it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(battery_optimizer_actuator_observed_grid_power_watts)",
          "legendFormat": "Grid import",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "avg_over_time(max(battery_optimizer_actuator_observed_grid_power_watts)[15m:1m])",
          "legendFormat": "Grid import, 15 min mean",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "vector(5000)",
          "legendFormat": "Import limit",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Import limit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Battery state of charge and charge power (the soak waits for it)",
      "id": 12,
      "description": "Omnibattery SOC (soak starts at about 90 to 95%) and the measured charge power (+ charge).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(hass_sensor_battery_percent{entity=\"sensor.venus_battery_soc\"})",
          "legendFormat": "State of charge (%)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(clamp_min(battery_optimizer_actuator_observed_battery_power_watts, 0)) / 1000",
          "legendFormat": "Charge power (kW)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Charge power (kW)"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "kwatt"
              },
              {
                "id": "custom.axisLabel",
                "value": "Charge power"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Hot water tank maximum per day against the 50 degC cap (degC)",
      "id": 13,
      "description": "Highest tank temperature in the last 24 h; the boost target stays at or below about 50 degC (heat pump only), above about 51 degC the 3 kW heater starts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max_over_time(max(hass_sensor_unit_celsius{entity=\"sensor.aquarea_tank_temperature\"})[1d:5m])",
          "legendFormat": "Tank maximum",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "vector(50)",
          "legendFormat": "Cap",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cap"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Heater states (1 = on)",
      "id": 14,
      "description": "Internal heater, external heater and sterilization states: boost must never start them.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 40
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (entity) (hass_binary_sensor_state{entity=~\"binary_sensor.aquarea_(internal_heater_state|external_heater_state|sterilization_state)\"})",
          "legendFormat": "{{entity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "stepAfter",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
