    {
      "type": "timeseries",
      "title": "Clamped power (W)",
      "id": 13,
      "description": "actuator_clamped_watts: the planned battery power the last tick could not request, because the PD target or the discharge cap was cut by the import cap or the entity's own maximum. A magnitude, not signed; 0 means nothing was cut. dry_run and live only.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
