          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Final plan energy not delivered (kWh, rolling 24 h)",
      "id": 15,
      "description": "Planned minus actual AC battery energy over the last 24 h, by direction: increase(shadow_planned_energy_kwh_total) - increase(shadow_actual_battery_energy_kwh_total). Positive: the final plan asked for more than the battery moved. Negative: it moved more than planned. Slot-level detail is in Battery: plan vs actual.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
