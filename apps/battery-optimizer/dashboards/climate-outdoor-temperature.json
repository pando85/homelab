          },
          "editorMode": "code",
          "expr": "avg_over_time(max(min_over_time(hass_sensor_unit_hz{entity=\"sensor.aquarea_compressor_frequency\"}[6h]) > bool 0)[1d:5m])",
          "legendFormat": "24 h",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
