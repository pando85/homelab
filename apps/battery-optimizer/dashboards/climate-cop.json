    {
      "type": "row",
      "title": "Drivers of the model terms (lift, starts, hours on)",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Lift: flow minus outdoor temperature in heat mode (K)",
      "id": 14,
      "description": "max(outlet temperature) - outdoor temperature, only while heat-mode power is above 0. The lift table covers lifts reached at about 26 to 28 degC water; lifts outside it read the nearest bin.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(hass_sensor_unit_celsius{entity=\"sensor.aquarea_outlet_temperature\"}) - on() max(hass_sensor_unit_celsius{entity=\"sensor.aquarea_outside_ambient_temperature\"}) and on() (max(hass_sensor_power_w{entity=\"sensor.aquarea_heat_power_consumed\"}) > 0)",
          "legendFormat": "Lift",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(hass_sensor_unit_celsius{entity=\"sensor.aquarea_outlet_temperature\"}) and on() (max(hass_sensor_power_w{entity=\"sensor.aquarea_heat_power_consumed\"}) > 0)",
          "legendFormat": "Flow temperature",
          "refId": "B"
