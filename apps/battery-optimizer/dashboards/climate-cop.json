    {
      "type": "timeseries",
      "title": "Compressor starts per day and hours on (rolling 24 h)",
      "id": 15,
      "description": "Starts (d term) and compressor hours (e term). The model was fitted on 10 to 15 h legacy days; a comfort schedule with more starts or longer low-frequency runs invalidates those terms.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(hass_sensor_state{entity=\"sensor.aquarea_compressor_start_stop_counter\"}[1d]))",
          "legendFormat": "Starts",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(hass_sensor_unit_hours{entity=\"sensor.aquarea_compressor_operating_hours\"}[1d]))",
          "legendFormat": "Hours on",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
