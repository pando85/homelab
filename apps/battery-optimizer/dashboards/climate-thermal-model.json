      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "climate"
      ],
      "targetBlank": false,
      "title": "Climate dashboards",
      "type": "dashboards"
    }
  ],
